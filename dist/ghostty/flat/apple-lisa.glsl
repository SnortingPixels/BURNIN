// Theme: Apple Lisa - LisaTerminal font
// Generated by src/build.py from src/template.glsl and themes/themes.json; edit those and rebuild.
// Ghostty custom shader (Shadertoy style). GLSL port of the Windows Terminal shader, which is a port of
// Swordfish90/cool-retro-term's terminal_dynamic.frag + terminal_static.frag (GPL-3.0).
// No bezel: the margin is the theme's own background colour; noise and the rolling scan line run through it.
// Burn-in: Ghostty can't give a shader the previous frame, so only the cursor leaves a fading phosphor afterglow
// where it just was (Ghostty 1.2+ cursor uniforms).
// Ghostty draws the terminal with the "CRT Source" colours (white text on black); this shader tints it.

// Shape
#define CURVATURE         0.0    // screen bulge (>0 convex like a CRT, 0 flat)
#define SCREEN_SIZE       1.0    // picture size; a convex bulge is zoomed by (1 + CURVATURE) so no text is cut off

// Theme
#define FONT_COLOR        vec3(0.0, 0.0, 0.0)   // #000000
#define BACK_COLOR        vec3(1.0, 1.0, 1.0)   // #ffffff
#define CHROMA            0.0    // how much original colour survives the tint
#define KEEP_ACCENTS      1.0    // 1 = coloured text keeps its colour, 0 = all tinted
#define ACCENT_SCALE      0.55    // brightness of kept colours (light/paper themes darken them to read as ink)
#define BLOOM_GAIN        0.0    // glow strength
#define BLOOM_MAX         0.5    // glow cap
#define GLOW_SPREAD       2.0    // glow width
#define STATIC_NOISE      0.02
#define GLOWING_LINE      0.0    // rolling bright band
#define FLICKERING        0.02
#define JITTER            0.0
#define HORIZONTAL_SYNC   0.0
#define AMBIENT_LIGHT     0.0   // soft glow from the middle of the tube
#define RGB_SHIFT         0.0    // colour fringing, in screen pixels
#define RASTER            0      // 0 none, 1 scanlines, 2 pixel grid, 3 RGB subpixels
#define PIXEL_SIZE        1.0    // screen pixels per font pixel
#define RASTER_STRENGTH  -1.0    // -1 = automatic like cool-retro-term (shows from 3 px up), else 0..1
#define PHOSPHOR_TAU      0.0   // P4
#define PHOSPHOR_POWER    0.0    // 0 = exponential decay, n = hyperbolic 1/(1+t/tau)^n with a long dim tail
#define AFTERGLOW_COLOR   vec3(0.0, 0.0, 0.0)   // cascade phosphors (P7): the colour the glow turns as it fades; 0 = unchanged
#define LCD_RESPONSE      0.0    // LCD pixel response (needs the previous frame: Windows only; unused here)
#define SWEEP_PERIOD      0.0    // radar: seconds per antenna turn; text is lit only where the beam passed, then fades; 0 = off
#define SHADES            0      // 4 = only four shades (Game Boy): BACK_COLOR, SHADE_1, SHADE_2, FONT_COLOR
#define SHADE_1           vec3(0.0, 0.0, 0.0)
#define SHADE_2           vec3(0.0, 0.0, 0.0)
#define PAPER_BARS        0      // > 0: printout paper, bands of BAR_COLOR this many text rows high
#define BAR_COLOR         vec3(0.0, 0.0, 0.0)
#define CELL_HEIGHT       26.0   // text row height in pixels at 100 % scaling
#define OVERLAY           0      // 1 = coloured plastic overlay in three horizontal bands (Vectrex)
#define OVERLAY_TOP       vec3(1.0, 1.0, 1.0)
#define OVERLAY_MID       vec3(1.0, 1.0, 1.0)
#define OVERLAY_BOTTOM    vec3(1.0, 1.0, 1.0)
#define MESH              0.0    // control-grid wire mesh in front of the glow (VFD): 0 none .. 1 opaque wires
#define MESH_PITCH        4.0    // mesh spacing in pixels
#define REFRESH_HZ        0.0    // the real screen's refresh rate; its light pulses at this rate (0 = steady)
#define REFRESH_DEPTH     0.0    // how deep the pulse is at that rate, from the phosphor's decay time (src/build.py)
#define SCANLINES_PER_ROW 0.0    // the real screen's scan lines per text row; sets the scanline pitch (0 = PIXEL_SIZE)
#define INTERLACED        0      // 1 = interlaced: odd and even scan lines refresh in turn, each at half the rate
#define CELL_WIDTH        12.0   // text column width in pixels at 100 % scaling
#define LAMP_SIZE         0.8    // RASTER 5 (lamps / plotted points): lamp diameter as a fraction of its spacing
#define RAIN              0      // 1 = falling "digital rain" behind the text (The Matrix)
#define RAIN_COLOR        vec3(0.0, 1.0, 0.25)
#define RAIN_STRENGTH     0.35   // brightness of the rain's trails
#define PALETTE_SIZE      0      // 1..4: coloured text takes the nearest of these colours (e.g. LCARS)
#define PALETTE_0         vec3(1.0, 1.0, 1.0)
#define PALETTE_1         vec3(1.0, 1.0, 1.0)
#define PALETTE_2         vec3(1.0, 1.0, 1.0)
#define PALETTE_3         vec3(1.0, 1.0, 1.0)
#define REFRESH_ACROSS    0      // 1 = the picture is scanned left to right (a mirror-swept LED column), not top to bottom

float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
float rgb2grey(vec3 v) { return dot(v, vec3(0.21, 0.72, 0.04)); }
float max3(vec3 v) { return max(v.r, max(v.g, v.b)); }

// Phosphor brightness (linear light) t seconds after the beam left; see PHOSPHORS in src/build.py.
float phosphorDecay(float t)
{
    float tau = max(PHOSPHOR_TAU, 1e-4);
    return PHOSPHOR_POWER > 0.0 ? pow(1.0 + t / tau, -PHOSPHOR_POWER) : exp(-t / tau);
}

// Light above the background, recoloured towards the afterglow colour (cascade phosphors).
vec3 afterglow(vec3 light, float amount)
{
    vec3 a = AFTERGLOW_COLOR * max3(light) / max(max3(AFTERGLOW_COLOR), 1e-4);
    return mix(light, a, amount);
}


// Coloured text takes the palette colour closest in hue (PALETTE_SIZE > 0).
vec3 paletteColour(vec3 full)
{
    vec3 best = PALETTE_0;
    float score = dot(normalize(full + 1e-4), normalize(PALETTE_0 + 1e-4));
    if (PALETTE_SIZE > 1) { float k = dot(normalize(full + 1e-4), normalize(PALETTE_1 + 1e-4)); if (k > score) { score = k; best = PALETTE_1; } }
    if (PALETTE_SIZE > 2) { float k = dot(normalize(full + 1e-4), normalize(PALETTE_2 + 1e-4)); if (k > score) { score = k; best = PALETTE_2; } }
    if (PALETTE_SIZE > 3) { float k = dot(normalize(full + 1e-4), normalize(PALETTE_3 + 1e-4)); if (k > score) { score = k; best = PALETTE_3; } }
    return best;
}

// Falling code: columns of glyph-like dot patterns with a bright head and a fading trail (y counted from the top).
vec3 digitalRain(vec2 p, float s)
{
    vec2 cell = vec2(CELL_WIDTH, CELL_HEIGHT) * s;
    float col = floor(p.x / cell.x), row = floor(p.y / cell.y);
    float rows = iResolution.y / cell.y + 24.0;
    float speed = mix(5.0, 14.0, hash(vec2(col, 3.1)));
    float head = fract(iTime * speed / rows + hash(vec2(col, 7.7))) * rows;
    float d = head - row;   // rows behind the head
    float trail = d >= 0.0 ? exp(-d / 7.0) : 0.0;
    vec2 gl = floor(fract(p / cell) * vec2(5.0, 9.0));
    float shape = step(0.45, hash(vec2(col * 7.0 + gl.x, row * 13.0 + gl.y) + floor(iTime * 2.0 + hash(vec2(col, row)) * 9.0)));
    shape *= step(1.0, gl.y) * step(gl.y, 7.0);
    float headLight = step(0.0, d) * step(d, 1.0);
    return (RAIN_COLOR * trail + headLight * 0.3) * shape * RAIN_STRENGTH;
}

vec3 chroma(vec3 c)
{
    float grey = rgb2grey(c);
    vec3 fg = mix(FONT_COLOR, c * FONT_COLOR / max(grey, 0.0001), CHROMA);
    return mix(BACK_COLOR, fg, grey);
}

// Grey/white text gets the phosphor colour; clearly coloured text keeps its own colour.
vec3 tint(vec3 c)
{
    float hi = max(c.r, max(c.g, c.b));
    float sat = (hi - min(c.r, min(c.g, c.b))) / max(hi, 0.0001);
    float keep = smoothstep(0.15, 0.35, sat) * smoothstep(0.02, 0.06, hi);
    // The terminal draws text on black, so anti-aliased edges are "colour x coverage".
    // Rebuild them over the theme background instead, so edges fade into the screen, not into black.
    vec3 full = c / max(hi, 0.0001);
    if (PALETTE_SIZE > 0) full = paletteColour(full);
    vec3 accent = mix(BACK_COLOR, full * ACCENT_SCALE, hi);
    return mix(chroma(c), accent, keep * KEEP_ACCENTS);
}

vec2 shape(vec2 tex)
{
    vec2 c = tex * 2.0 - 1.0;
    c *= 1.0 + dot(c, c) * CURVATURE;
    vec2 uv = c * 0.5 + 0.5;
    return (uv - 0.5) / (SCREEN_SIZE * (1.0 + max(CURVATURE, 0.0))) + 0.5;
}

vec3 sampleRgb(vec2 uv)
{
    vec3 c = texture(iChannel0, uv).rgb;
    if (RGB_SHIFT > 0.0)
    {
        vec2 d = vec2(RGB_SHIFT / iResolution.x, 0.0);
        vec3 r = texture(iChannel0, uv + d).rgb;
        vec3 l = texture(iChannel0, uv - d).rgb;
        c.r = l.r * 0.10 + r.r * 0.30 + c.r * 0.60;
        c.g = l.g * 0.20 + r.g * 0.20 + c.g * 0.60;
        c.b = l.b * 0.30 + r.b * 0.10 + c.b * 0.60;
    }
    return c;
}

// cool-retro-term's rasterization, on the font's own pixel grid.
vec3 raster(vec2 uv, vec3 texel, float density)
{
#if RASTER == 0
    return texel;
#else
    float intensity = RASTER_STRENGTH < 0.0 ? smoothstep(2.0, 4.0, density) : RASTER_STRENGTH;
    vec2 cell = fract(uv * iResolution.xy / density) * 2.0 - 1.0;
    vec3 hiC = (1.30 - 0.2 * texel) * texel;
    vec3 loC = (0.70 + 0.1 * texel) * texel;
  #if RASTER == 1
    float mask = 1.0 - abs(cell.y);
    return mix(texel, mix(loC, hiC, mask), intensity);
  #elif RASTER == 2
    vec2 c2 = cell * cell;
    float mask = 1.0 - c2.x - c2.y;
    return mix(texel, mix(loC, hiC, mask), intensity);
  #elif RASTER == 5
    return texel;   // lamps: shaped in mainImage
  #elif RASTER == 4
    float mask = 1.0 - abs(cell.x);   // vertical columns (a scanned LED column)
    return mix(texel, mix(loC, hiC, mask), intensity);
  #else
    vec3 offs = 3.141592654 * vec3(0.5, 0.5 - 2.0 / 3.0, 0.5 - 4.0 / 3.0);
    float ang = uv.x * iResolution.x / density * 6.283185307;
    vec3 res = texel * (3.0 + sin(ang + offs)) / 4.0;
    vec3 hiS = (1.30 - 0.2 * res) * res;
    vec3 loS = (0.70 + 0.1 * res) * res;
    float mask = 1.0 - abs(cell.y);
    return mix(texel, mix(loS, hiS, mask), intensity);
  #endif
#endif
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    float s = 1.0;
    vec2 tex = fragCoord / iResolution.xy;          // texture coordinates (y up)
    float yDown = 1.0 - tex.y;                      // y from the top, for effects with a direction
    float frame = floor(iTime * 60.0);
    float r1 = hash(vec2(frame, 1.7));
    float r2 = hash(vec2(frame, 9.1));
    float density = SCANLINES_PER_ROW > 0.0 ? CELL_HEIGHT * s / max(SCANLINES_PER_ROW, 1.0) : PIXEL_SIZE * s;

    // Whole-window effects (picture and margin alike): grain, rolling scan line.
    vec2 grain = floor(fragCoord / max(2.0 * s, density));
    float n1 = hash(grain + fract(iTime * 19.6) * 113.0);
    float n2 = hash(grain.yx + fract(iTime * 4.2) * 71.0);
    float dist = length(0.5 - tex);
    float extra = n1 * STATIC_NOISE * clamp(1.0 - dist * 1.3, 0.0, 1.0);
    float band = 120.0 * s;
    float yWin = yDown * iResolution.y;
    extra += fract(smoothstep(-band, 0.0, yWin - (iResolution.y + band) * fract(iTime * 0.15))) * GLOWING_LINE;

    // Radar sweep: the beam turns clockwise from 12 o'clock; "since" is how long ago it passed this pixel.
    float lit = 1.0, flash = 1.0;
    if (SWEEP_PERIOD > 0.0)
    {
        vec2 c = (tex - 0.5) * iResolution.xy;
        float since = fract(iTime / SWEEP_PERIOD - atan(c.x, c.y) / 6.283185) * SWEEP_PERIOD;
        lit = pow(phosphorDecay(since), 1.0 / 2.2);
        flash = exp(-since / 0.03);
        extra = extra * lit + flash * 0.12;   // the beam lights the noise ("grass") as it passes
    }
    vec3 surround = chroma(vec3(extra));   // BACK_COLOR plus noise and scan line
#if RAIN
    surround += digitalRain(vec2(fragCoord.x, iResolution.y - fragCoord.y), s);
#endif
    if (SWEEP_PERIOD > 0.0)
        surround = BACK_COLOR + afterglow(surround - BACK_COLOR, 1.0 - flash);

    vec3 color = surround;
    vec2 uv = shape(tex);
    if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0)
    {
        // Horizontal sync wobble (rare, tiny).
        float hsStrength = mix(0.05, 0.35, HORIZONTAL_SYNC);
        float randval = hsStrength - r1;
        float distScale = step(0.0, randval) * randval * hsStrength * HORIZONTAL_SYNC;
        float distFreq = mix(4.0, 40.0, r2);
        vec2 coords = uv;
        coords.x += sin((1.0 - coords.y + iTime) * distFreq) * distScale;

        // Jitter.
        coords += (vec2(n1, n2) - 0.5) * vec2(0.007, 0.002) * JITTER * JITTER;

#if RASTER == 5
        // Lamps / plotted points: each lamp shows the text at its centre, as a round spot.
        vec2 lampPx = coords * iResolution.xy / density;
        vec2 lampOff = fract(lampPx) * 2.0 - 1.0;
        vec3 txt = sampleRgb((floor(lampPx) + 0.5) * density / iResolution.xy) * smoothstep(LAMP_SIZE, LAMP_SIZE * 0.6, length(lampOff));
#else
        vec3 txt = sampleRgb(coords);
#endif

        // Burn-in: the cell the cursor just left keeps glowing and fades by the phosphor's decay law (src/build.py).
        // Cursor rectangles are (left, top, width, height) in pixels, y up.
        if (PHOSPHOR_TAU > 0.0 && SWEEP_PERIOD == 0.0 && iPreviousCursor.xy != iCurrentCursor.xy)
        {
            vec2 p = coords * iResolution.xy;
            vec2 lo = iPreviousCursor.xy - vec2(0.0, iPreviousCursor.w);
            vec2 inside = smoothstep(lo - 1.0, lo + 1.0, p) * (1.0 - smoothstep(lo + iPreviousCursor.zw - 1.0, lo + iPreviousCursor.zw + 1.0, p));
            float t = max(iTime - iTimeCursorChange, 0.0);
            float lin = phosphorDecay(t);
            float glow = inside.x * inside.y * pow(lin, 1.0 / 2.2);
            glow *= step(0.006, glow);
            txt = max(txt, vec3(glow));
        }

        txt = raster(coords, txt, density) * lit;

        // Work on light above the background, so empty screen equals the margin exactly.
        vec3 pic = tint(txt) - BACK_COLOR;
        if (SWEEP_PERIOD > 0.0)
            pic = afterglow(pic, 1.0 - flash);
        pic += surround;

        // Bloom: wide gaussian of the lit picture, capped by its brightest channel, screen-blended.
        vec2 px = GLOW_SPREAD * s / iResolution.xy;
        vec3 blur = vec3(0.0);
        float wsum = 0.0;
        for (int x = -4; x <= 4; x++)
            for (int yy = -4; yy <= 4; yy++)
            {
                float w = exp(-float(x * x + yy * yy) / 8.0);
                blur += texture(iChannel0, coords + vec2(float(x), float(yy)) * px).rgb * w;
                wsum += w;
            }
        vec3 bloom = max(tint(blur / wsum) - BACK_COLOR, 0.0) * BLOOM_GAIN;
        bloom *= min(1.0, BLOOM_MAX / max(max(bloom.r, max(bloom.g, bloom.b)), 0.0001));
        if (SWEEP_PERIOD > 0.0)
            bloom = afterglow(bloom * lit, 1.0 - flash);
        pic = 1.0 - (1.0 - clamp(pic, 0.0, 1.0)) * (1.0 - bloom);

        // Soft edge into the margin.
        vec2 e = min(uv, 1.0 - uv) * iResolution.xy;
        color = mix(surround, pic, clamp(min(e.x, e.y) / 2.0, 0.0, 1.0));
    }

    // Ambient light from the middle of the tube.
    color += FONT_COLOR * AMBIENT_LIGHT * clamp(1.0 - dist * 1.6, 0.0, 1.0);

    // Flicker scales the light, not the background.
    color = BACK_COLOR + (color - BACK_COLOR) * (1.0 + (r2 - 0.5) * FLICKERING);

    // Refresh: the real screen's light pulses at its refresh rate as the beam scans down. Shown as the pulse's
    // fundamental, averaged over this monitor's frame; left out when this monitor is too slow to show that rate.
    if (REFRESH_HZ > 0.0 && REFRESH_DEPTH > 0.0 && iTimeDelta > 0.0)
    {
        float fdt = min(iTimeDelta, 0.1);
        float x = 3.14159265 * REFRESH_HZ * fdt;
        float shown = step(REFRESH_HZ * fdt, 0.5) * sin(x) / max(x, 1e-4);
        float rate = INTERLACED != 0 ? REFRESH_HZ * 0.5 : REFRESH_HZ;   // each line's own refresh rate
        x = 3.14159265 * rate * fdt;
        shown = step(rate * fdt, 0.5) * sin(x) / max(x, 1e-4);
        float odd = INTERLACED != 0 ? mod(floor((iResolution.y - fragCoord.y) / density), 2.0) * 0.5 : 0.0;   // the other field comes half a frame later
        float pulse = cos(6.2831853 * ((iTime - fdt * 0.5) * rate - (REFRESH_ACROSS != 0 ? tex.x : yDown) - odd));
        color *= 1.0 + REFRESH_DEPTH * shown * pulse;   // all the tube's light pulses, background glow included
    }

#if SHADES == 4
    // Four-shade LCD: snap to the nearest of the panel's shades along the background-to-text line.
    vec3 axis = FONT_COLOR - BACK_COLOR;
    float q = floor(clamp(dot(color - BACK_COLOR, axis) / max(dot(axis, axis), 1e-5), 0.0, 1.0) * 3.0 + 0.5);
    color = q < 0.5 ? BACK_COLOR : (q < 1.5 ? SHADE_1 : (q < 2.5 ? SHADE_2 : FONT_COLOR));
#endif

    // Control-grid wire mesh in front of a vacuum fluorescent display.
    if (MESH > 0.0)
    {
        vec2 m = mod(floor(fragCoord), max(floor(MESH_PITCH * s), 2.0));
        color = BACK_COLOR + (color - BACK_COLOR) * (1.0 - MESH * clamp(step(m.x, 0.0) + step(m.y, 0.0), 0.0, 1.0));
    }

#if PAPER_BARS > 0
    // Printout paper: ink is printed over alternating plain and coloured bands (counted from the top).
    float bar = mod(floor(yDown * iResolution.y / (CELL_HEIGHT * s * float(PAPER_BARS))), 2.0);
    color *= mix(vec3(1.0), BAR_COLOR / max(BACK_COLOR, vec3(0.001)), bar);
#endif

#if OVERLAY
    // Translucent coloured plastic over the tube, in three bands.
    color *= yDown < 0.25 ? OVERLAY_TOP : (yDown < 0.75 ? OVERLAY_MID : OVERLAY_BOTTOM);
#endif

    // Fine dither noise, as in the original static pass.
    color += (hash(tex * iResolution.xy + fract(iTime)) - 0.5) * 0.025;

    fragColor = vec4(clamp(color, 0.0, 1.0), 1.0);
}
