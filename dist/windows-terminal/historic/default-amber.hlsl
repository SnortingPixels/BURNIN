// Theme: Default Amber - cool-retro-term profile
// Generated by src/build.py from src/template.hlsl and themes/themes.json; edit those and rebuild.
// Windows Terminal pixel shader. Port of Swordfish90/cool-retro-term terminal_dynamic.frag + terminal_static.frag (GPL-3.0).
// No bezel: the margin is the theme's own background colour; noise and the rolling scan line run through it too.
// Burn-in (phosphor afterglow) needs the optional BURNIN Windhawk mod: Windows Terminal can't give a shader the
// previous frame, so the mod copies each finished frame and binds it below. Without the mod nothing changes.
Texture2D shaderTexture;
SamplerState samplerState;

cbuffer PixelShaderSettings {
    float  Time;
    float  Scale;
    float2 Resolution;
    float4 Background;
};

// Filled in by the BURNIN Windhawk mod (unbound = zeros = burn-in off). The mod finds this shader by these names.
Texture2D BurninPrevFrame : register(t2);
cbuffer BurninFrame : register(b1) {
    float BurninDt;      // seconds since the previous frame
    float3 BurninPad;
};

// Shape
#define CURVATURE         0.03    // screen bulge (>0 convex like a CRT, 0 flat); a bulge shifts text away from where Terminal puts the mouse/selection
#define SCREEN_SIZE       1.0    // picture size; a convex bulge is zoomed by (1 + CURVATURE) so no text is cut off

// Theme
#define FONT_COLOR        float3(1.0, 0.506, 0.0)   // #ff8100
#define BACK_COLOR        float3(0.0, 0.0, 0.0)   // #000000
#define CHROMA            0.2    // how much original colour survives the tint
#define KEEP_ACCENTS      1.0    // 1 = coloured text keeps its colour, 0 = all tinted
#define ACCENT_SCALE      1.0    // brightness of kept colours (light/paper themes darken them to read as ink)
#define BLOOM_GAIN        1.5    // glow strength
#define BLOOM_MAX         0.5    // glow cap
#define GLOW_SPREAD       2.0    // glow width
#define STATIC_NOISE      0.1
#define GLOWING_LINE      0.2    // rolling bright band
#define FLICKERING        0.1
#define JITTER            0.2
#define HORIZONTAL_SYNC   0.1
#define AMBIENT_LIGHT     0.06   // soft glow from the middle of the tube
#define RGB_SHIFT         0.0    // colour fringing, in screen pixels
#define RASTER            0      // 0 none, 1 scanlines, 2 pixel grid, 3 RGB subpixels
#define PIXEL_SIZE        1.0    // screen pixels per font pixel
#define RASTER_STRENGTH  -1.0    // -1 = automatic like cool-retro-term (shows from 3 px up), else 0..1
#define PHOSPHOR_TAU      0.0056   // P3
#define PHOSPHOR_POWER    0.0    // 0 = exponential decay, n = hyperbolic 1/(1+t/tau)^n with a long dim tail
#define AFTERGLOW_COLOR   float3(0.0, 0.0, 0.0)   // cascade phosphors (P7): the colour the glow turns as it fades; 0 = unchanged
#define LCD_RESPONSE      0.0    // LCD pixel response time constant in seconds: slow pixels smear both ways; 0 = not an LCD
#define SWEEP_PERIOD      0.0    // radar: seconds per antenna turn; text is lit only where the beam passed, then fades; 0 = off
#define SHADES            0      // 4 = only four shades (Game Boy): BACK_COLOR, SHADE_1, SHADE_2, FONT_COLOR
#define SHADE_1           float3(0.0, 0.0, 0.0)
#define SHADE_2           float3(0.0, 0.0, 0.0)
#define PAPER_BARS        0      // > 0: printout paper, bands of BAR_COLOR this many text rows high
#define BAR_COLOR         float3(0.0, 0.0, 0.0)
#define CELL_HEIGHT       26.0   // text row height in pixels at 100 % scaling
#define OVERLAY           0      // 1 = coloured plastic overlay in three horizontal bands (Vectrex)
#define OVERLAY_TOP       float3(1.0, 1.0, 1.0)
#define OVERLAY_MID       float3(1.0, 1.0, 1.0)
#define OVERLAY_BOTTOM    float3(1.0, 1.0, 1.0)
#define MESH              0.0    // control-grid wire mesh in front of the glow (VFD): 0 none .. 1 opaque wires
#define MESH_PITCH        4.0    // mesh spacing in pixels at 100 % scaling
#define REFRESH_HZ        0.0    // the real screen's refresh rate; its light pulses at this rate (0 = steady)
#define REFRESH_DEPTH     0.0    // how deep the pulse is at that rate, from the phosphor's decay time (src/build.py)
#define SCANLINES_PER_ROW 0.0    // the real screen's scan lines per text row; sets the scanline pitch (0 = PIXEL_SIZE)
#define INTERLACED        0      // 1 = interlaced: odd and even scan lines refresh in turn, each at half the rate
#define CELL_WIDTH        12.0   // text column width in pixels at 100 % scaling
#define LAMP_SIZE         0.8    // RASTER 5 (lamps / plotted points): lamp diameter as a fraction of its spacing
#define RAIN              0      // 1 = falling "digital rain" behind the text (The Matrix)
#define RAIN_COLOR        float3(0.0, 1.0, 0.25)
#define RAIN_STRENGTH     0.35   // brightness of the rain's trails
#define PALETTE_SIZE      0      // 1..4: coloured text takes the nearest of these colours (e.g. LCARS)
#define PALETTE_0         float3(1.0, 1.0, 1.0)
#define PALETTE_1         float3(1.0, 1.0, 1.0)
#define PALETTE_2         float3(1.0, 1.0, 1.0)
#define PALETTE_3         float3(1.0, 1.0, 1.0)
#define REFRESH_ACROSS    0      // 1 = the picture is scanned left to right (a mirror-swept LED column), not top to bottom

float hash(float2 p) { return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453); }
float rgb2grey(float3 v) { return dot(v, float3(0.21, 0.72, 0.04)); }

float max3(float3 v) { return max(v.r, max(v.g, v.b)); }

// Phosphor brightness (linear light) t seconds after the beam left; see PHOSPHORS in src/build.py.
float phosphorDecay(float t)
{
    float tau = max(PHOSPHOR_TAU, 1e-4);
    return PHOSPHOR_POWER > 0.0 ? pow(1.0 + t / tau, -PHOSPHOR_POWER) : exp(-t / tau);
}

// Light above the background, recoloured towards the afterglow colour (cascade phosphors).
float3 afterglow(float3 light, float amount)
{
    float3 a = AFTERGLOW_COLOR * max3(light) / max(max3(AFTERGLOW_COLOR), 1e-4);
    return lerp(light, a, amount);
}


// Coloured text takes the palette colour closest in hue (PALETTE_SIZE > 0).
float3 paletteColour(float3 full)
{
    float3 best = PALETTE_0;
    float score = dot(normalize(full + 1e-4), normalize(PALETTE_0 + 1e-4));
    if (PALETTE_SIZE > 1) { float k = dot(normalize(full + 1e-4), normalize(PALETTE_1 + 1e-4)); if (k > score) { score = k; best = PALETTE_1; } }
    if (PALETTE_SIZE > 2) { float k = dot(normalize(full + 1e-4), normalize(PALETTE_2 + 1e-4)); if (k > score) { score = k; best = PALETTE_2; } }
    if (PALETTE_SIZE > 3) { float k = dot(normalize(full + 1e-4), normalize(PALETTE_3 + 1e-4)); if (k > score) { score = k; best = PALETTE_3; } }
    return best;
}

// Falling code: columns of glyph-like dot patterns with a bright head and a fading trail (y counted from the top).
float3 digitalRain(float2 p, float s)
{
    float2 cell = float2(CELL_WIDTH, CELL_HEIGHT) * s;
    float col = floor(p.x / cell.x), row = floor(p.y / cell.y);
    float rows = Resolution.y / cell.y + 24.0;
    float speed = lerp(5.0, 14.0, hash(float2(col, 3.1)));
    float head = frac(Time * speed / rows + hash(float2(col, 7.7))) * rows;
    float d = head - row;   // rows behind the head
    float trail = d >= 0.0 ? exp(-d / 7.0) : 0.0;
    float2 gl = floor(frac(p / cell) * float2(5.0, 9.0));
    float shape = step(0.45, hash(float2(col * 7.0 + gl.x, row * 13.0 + gl.y) + floor(Time * 2.0 + hash(float2(col, row)) * 9.0)));
    shape *= step(1.0, gl.y) * step(gl.y, 7.0);
    float headLight = step(0.0, d) * step(d, 1.0);
    return (RAIN_COLOR * trail + headLight * 0.3) * shape * RAIN_STRENGTH;
}

float3 chroma(float3 c)
{
    float grey = rgb2grey(c);
    float3 fg = lerp(FONT_COLOR, c * FONT_COLOR / max(grey, 0.0001), CHROMA);
    return lerp(BACK_COLOR, fg, grey);
}

// Grey/white text gets the phosphor colour; clearly coloured text keeps its own colour.
float3 tint(float3 c)
{
    float hi = max(c.r, max(c.g, c.b));
    float sat = (hi - min(c.r, min(c.g, c.b))) / max(hi, 0.0001);
    float keep = smoothstep(0.15, 0.35, sat) * smoothstep(0.02, 0.06, hi);
    // Terminal draws text on black, so anti-aliased edges are "colour x coverage".
    // Rebuild them over the theme background instead, so edges fade into the screen, not into black.
    float3 full = c / max(hi, 0.0001);
    if (PALETTE_SIZE > 0) full = paletteColour(full);
    float3 accent = lerp(BACK_COLOR, full * ACCENT_SCALE, hi);
    return lerp(chroma(c), accent, keep * KEEP_ACCENTS);
}

float2 shape(float2 tex)
{
    float2 c = tex * 2.0 - 1.0;
    c *= 1.0 + dot(c, c) * CURVATURE;
    float2 uv = c * 0.5 + 0.5;
    return (uv - 0.5) / (SCREEN_SIZE * (1.0 + max(CURVATURE, 0.0))) + 0.5;
}

float3 sampleRgb(float2 uv)
{
    float3 c = shaderTexture.Sample(samplerState, uv).rgb;
    if (RGB_SHIFT > 0.0)
    {
        float2 d = float2(RGB_SHIFT / Resolution.x, 0.0);
        float3 r = shaderTexture.Sample(samplerState, uv + d).rgb;
        float3 l = shaderTexture.Sample(samplerState, uv - d).rgb;
        c.r = l.r * 0.10 + r.r * 0.30 + c.r * 0.60;
        c.g = l.g * 0.20 + r.g * 0.20 + c.g * 0.60;
        c.b = l.b * 0.30 + r.b * 0.10 + c.b * 0.60;
    }
    return c;
}

// cool-retro-term's rasterization, on the font's own pixel grid.
float3 raster(float2 uv, float3 texel, float density)
{
#if RASTER == 0
    return texel;
#else
    float intensity = RASTER_STRENGTH < 0.0 ? smoothstep(2.0, 4.0, density) : RASTER_STRENGTH;
    float2 cell = frac(uv * Resolution / density) * 2.0 - 1.0;
    float3 hiC = (1.30 - 0.2 * texel) * texel;
    float3 loC = (0.70 + 0.1 * texel) * texel;
  #if RASTER == 1
    float mask = 1.0 - abs(cell.y);
    return lerp(texel, lerp(loC, hiC, mask), intensity);
  #elif RASTER == 2
    float2 c2 = cell * cell;
    float mask = 1.0 - c2.x - c2.y;
    return lerp(texel, lerp(loC, hiC, mask), intensity);
  #elif RASTER == 5
    return texel;   // lamps: shaped in main
  #elif RASTER == 4
    float mask = 1.0 - abs(cell.x);   // vertical columns (a scanned LED column)
    return lerp(texel, lerp(loC, hiC, mask), intensity);
  #else
    float3 offs = 3.141592654 * float3(0.5, 0.5 - 2.0 / 3.0, 0.5 - 4.0 / 3.0);
    float ang = uv.x * Resolution.x / density * 6.283185307;
    float3 res = texel * (3.0 + sin(ang + offs)) / 4.0;
    float3 hiS = (1.30 - 0.2 * res) * res;
    float3 loS = (0.70 + 0.1 * res) * res;
    float mask = 1.0 - abs(cell.y);
    return lerp(texel, lerp(loS, hiS, mask), intensity);
  #endif
#endif
}

float4 main(float4 pos : SV_POSITION, float2 tex : TEXCOORD) : SV_TARGET
{
    float s = max(Scale, 1.0);
    float frame = floor(Time * 60.0);
    float r1 = hash(float2(frame, 1.7));
    float r2 = hash(float2(frame, 9.1));
    float density = SCANLINES_PER_ROW > 0.0 ? CELL_HEIGHT * s / max(SCANLINES_PER_ROW, 1.0) : PIXEL_SIZE * s;

    // Whole-window effects (picture and margin alike): grain, rolling scan line.
    float2 grain = floor(pos.xy / max(2.0 * s, density));
    float n1 = hash(grain + frac(Time * 19.6) * 113.0);
    float n2 = hash(grain.yx + frac(Time * 4.2) * 71.0);
    float dist = length(0.5 - tex);
    float extra = n1 * STATIC_NOISE * saturate(1.0 - dist * 1.3);
    float band = 120.0 * s;
    float yWin = tex.y * Resolution.y;
    extra += frac(smoothstep(-band, 0.0, yWin - (Resolution.y + band) * frac(Time * 0.15))) * GLOWING_LINE;

    // Radar sweep: the beam turns clockwise from 12 o'clock; "since" is how long ago it passed this pixel.
    float lit = 1.0, flash = 1.0;
    if (SWEEP_PERIOD > 0.0)
    {
        float2 c = (tex - 0.5) * Resolution;
        float since = frac(Time / SWEEP_PERIOD - atan2(c.x, -c.y) / 6.283185) * SWEEP_PERIOD;
        lit = pow(phosphorDecay(since), 1.0 / 2.2);
        flash = exp(-since / 0.03);
        extra = extra * lit + flash * 0.12;   // the beam lights the noise ("grass") as it passes
    }
    float3 surround = chroma(extra);   // BACK_COLOR plus noise and scan line
#if RAIN
    surround += digitalRain(pos.xy, s);
#endif
    if (SWEEP_PERIOD > 0.0)
        surround = BACK_COLOR + afterglow(surround - BACK_COLOR, 1.0 - flash);

    float3 color = surround;
    float2 uv = shape(tex);
    if (uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0)
    {
        // Horizontal sync wobble (rare, tiny).
        float hsStrength = lerp(0.05, 0.35, HORIZONTAL_SYNC);
        float randval = hsStrength - r1;
        float distScale = step(0.0, randval) * randval * hsStrength * HORIZONTAL_SYNC;
        float distFreq = lerp(4.0, 40.0, r2);
        float2 coords = uv;
        coords.x += sin((coords.y + Time) * distFreq) * distScale;

        // Jitter.
        coords += (float2(n1, n2) - 0.5) * float2(0.007, 0.002) * JITTER * JITTER;

#if RASTER == 5
        // Lamps / plotted points: each lamp shows the text at its centre, as a round spot.
        float2 lampPx = coords * Resolution / density;
        float2 lampOff = frac(lampPx) * 2.0 - 1.0;
        float3 txt = sampleRgb((floor(lampPx) + 0.5) * density / Resolution) * smoothstep(LAMP_SIZE, LAMP_SIZE * 0.6, length(lampOff)) * lit;
#else
        float3 txt = raster(coords, sampleRgb(coords), density) * lit;
#endif

        // Work on light above the background, so empty screen equals the margin exactly.
        float3 pic = tint(txt) - BACK_COLOR;
        if (SWEEP_PERIOD > 0.0)
            pic = afterglow(pic, 1.0 - flash);
        pic += surround;

        // Bloom: wide gaussian of the lit picture, capped by its brightest channel, screen-blended.
        float2 px = GLOW_SPREAD * s / Resolution;
        float3 blur = 0;
        float wsum = 0;
        [unroll] for (int x = -4; x <= 4; x++)
            [unroll] for (int yy = -4; yy <= 4; yy++)
            {
                float w = exp(-(x * x + yy * yy) / 8.0);
                blur += shaderTexture.Sample(samplerState, coords + float2(x, yy) * px).rgb * w;
                wsum += w;
            }
        float3 bloom = max(tint(blur / wsum) - BACK_COLOR, 0.0) * BLOOM_GAIN;
        bloom *= min(1.0, BLOOM_MAX / max(max(bloom.r, max(bloom.g, bloom.b)), 0.0001));
        if (SWEEP_PERIOD > 0.0)
            bloom = afterglow(bloom * lit, 1.0 - flash);
        pic = 1.0 - (1.0 - saturate(pic)) * (1.0 - bloom);

        // Soft edge into the margin.
        float2 e = min(uv, 1.0 - uv) * Resolution;
        color = lerp(surround, pic, saturate(min(e.x, e.y) / 2.0));
    }

    // Ambient light from the middle of the tube.
    color += FONT_COLOR * AMBIENT_LIGHT * saturate(1.0 - dist * 1.6);

    // Flicker scales the light, not the background.
    color = BACK_COLOR + (color - BACK_COLOR) * (1.0 + (r2 - 0.5) * FLICKERING);

    // Refresh: the real screen's light pulses at its refresh rate as the beam scans down. Shown as the pulse's
    // fundamental, averaged over this monitor's frame (needs the frame time from the Windhawk mod); left out when this
    // monitor is too slow to show that rate, rather than faking a slower flicker.
    if (REFRESH_HZ > 0.0 && REFRESH_DEPTH > 0.0 && BurninDt > 0.0)
    {
        float fdt = min(BurninDt, 0.1);
        float x = 3.14159265 * REFRESH_HZ * fdt;
        float shown = step(REFRESH_HZ * fdt, 0.5) * sin(x) / max(x, 1e-4);
        float rate = INTERLACED ? REFRESH_HZ * 0.5 : REFRESH_HZ;   // each line's own refresh rate
        x = 3.14159265 * rate * fdt;
        shown = step(rate * fdt, 0.5) * sin(x) / max(x, 1e-4);
        float odd = INTERLACED ? fmod(floor(pos.y / density), 2.0) * 0.5 : 0.0;   // the other field comes half a frame later
        float pulse = cos(6.2831853 * ((Time - fdt * 0.5) * rate - (REFRESH_ACROSS ? tex.x : tex.y) - odd));
        color *= 1.0 + REFRESH_DEPTH * shown * pulse;   // all the tube's light pulses, background glow included
    }

#if SHADES == 4
    // Four-shade LCD: snap to the nearest of the panel's shades along the background-to-text line.
    float3 axis = FONT_COLOR - BACK_COLOR;
    float q = floor(saturate(dot(color - BACK_COLOR, axis) / max(dot(axis, axis), 1e-5)) * 3.0 + 0.5);
    color = q < 0.5 ? BACK_COLOR : (q < 1.5 ? SHADE_1 : (q < 2.5 ? SHADE_2 : FONT_COLOR));
#endif

    // Control-grid wire mesh in front of a vacuum fluorescent display.
    if (MESH > 0.0)
    {
        float2 m = fmod(floor(pos.xy), max(floor(MESH_PITCH * s), 2.0));
        color = BACK_COLOR + (color - BACK_COLOR) * (1.0 - MESH * saturate(step(m.x, 0.0) + step(m.y, 0.0)));
    }

#if PAPER_BARS > 0
    // Printout paper: ink is printed over alternating plain and coloured bands.
    float bar = fmod(floor(pos.y / (CELL_HEIGHT * s * PAPER_BARS)), 2.0);
    color *= lerp(float3(1.0, 1.0, 1.0), BAR_COLOR / max(BACK_COLOR, 0.001), bar);
#endif

#if OVERLAY
    // Translucent coloured plastic over the tube, in three bands.
    color *= tex.y < 0.25 ? OVERLAY_TOP : (tex.y < 0.75 ? OVERLAY_MID : OVERLAY_BOTTOM);
#endif

    // Fine dither noise, as in the original static pass.
    color += (hash(tex * Resolution + frac(Time)) - 0.5) * 0.025;

    color = saturate(color);

    // Previous frame (from the Windhawk mod): phosphor afterglow or slow LCD pixels.
    if ((PHOSPHOR_TAU > 0.0 || LCD_RESPONSE > 0.0) && BurninDt > 0.0)
    {
        float4 prev = BurninPrevFrame.Load(int3(pos.xy, 0));
        float dt = min(BurninDt, 1.0);
        float valid = step(0.5, prev.a);
        if (LCD_RESPONSE > 0.0)
        {
            // Liquid crystal turns slowly both ways: move from the previous picture towards the new one, in linear light.
            float3 lin = lerp(pow(max(prev.rgb, 0.0), 2.2), pow(max(color, 0.0), 2.2), 1.0 - exp(-dt / LCD_RESPONSE));
            color = lerp(color, pow(max(lin, 0.0), 1.0 / 2.2), valid);
        }
        else
        {
            // Phosphor: the previous frame decays by the phosphor's own law (PHOSPHORS in src/build.py), in linear light;
            // keep whichever of it and the new picture is further from the background.
            float3 d = prev.rgb - BACK_COLOR;
            float3 lin = pow(abs(d), 2.2);
            if (PHOSPHOR_POWER > 0.0)
                lin = pow(pow(max(lin, 1e-6), -1.0 / max(PHOSPHOR_POWER, 0.001)) + dt / PHOSPHOR_TAU, -PHOSPHOR_POWER);
            else
                lin *= exp(-dt / PHOSPHOR_TAU);
            float3 a = pow(max(lin, 0.0), 1.0 / 2.2);
            a *= step(0.006, a);   // below 8-bit visibility: done
            float3 ghost = sign(d) * a;
            if (max3(AFTERGLOW_COLOR) > 0.0)
                ghost = afterglow(max(ghost, 0.0), 1.0);
            color = lerp(color, BACK_COLOR + ghost, step(abs(color - BACK_COLOR), abs(ghost)) * valid);
        }
    }

    return float4(color, 1.0);
}